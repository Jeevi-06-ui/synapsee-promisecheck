# ==============================================================================
# PromiseCheck Environment Configuration
# Team Synapsee — Presidency University, Bengaluru
# ==============================================================================

# Target Café Public URL (must be public HTTPS for TinyFish remote browser)
CAFE_PUBLIC_URL=https://synapsee-promisecheck.vercel.app/

# TinyFish Agent API Key (Obtain from https://agent.tinyfish.ai/api-keys)
# Required ONLY for live execution mode. Simulated mode runs offline without credentials.
# NEVER commit or leak this secret key.
TINYFISH_API_KEY=

# Local Web Dashboard Port (default: 4004)
PORT=4004

# Local Web Dashboard Host (default: 127.0.0.1)
HOST=127.0.0.1
